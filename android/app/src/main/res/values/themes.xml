<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme. Below API 27 the navigation bar cannot have dark icons, so it stays dark. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/red</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/red</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/board</item>
    </style>
</resources>
